# Entity: lookup

main: kit: entity: lookup: {

  alias: field: {}

  fields: [
    {
      format: "double"
      name: "elevation"
      req: false
      short: "Elevation in meters above sea level"
      type: "`$NUMBER`"
    }
    {
      format: "double"
      name: "latitude"
      req: false
      short: "Latitude of the location"
      type: "`$NUMBER`"
    }
    {
      name: "locations"
      req: true
      short: "Array of location objects with latitude and longitude"
      type: "`$ARRAY`"
    }
    {
      format: "double"
      name: "longitude"
      req: false
      short: "Longitude of the location"
      type: "`$NUMBER`"
    }
    {
      name: "results"
      req: false
      short: "Array of elevation results for the requested locations"
      type: "`$ARRAY`"
    }
  ]

  name: "lookup"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/api/v1/lookup"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "lookup"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: "10,10|20,20|41.161758,-8.583933"
                kind: "query"
                name: "location"
                orig: "location"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/v1/lookup"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "lookup"
            }
          ]
          select: {
            exist: [
              "location"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
      ]
    }
  }



}
